# Obrigatórios: escolha valores locais antes de executar o Compose.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# URI PostgreSQL; no Compose, host postgres e porta interna padrão 5432.
# Use os mesmos dados acima; caracteres especiais da URI precisam de percent-encoding.
DATABASE_URL=
BACKEND_PORT=
FRONTEND_PORT=
# Endereço de interface local para publicação dos serviços.
BIND_ADDRESS=
# Parâmetros operacionais explícitos para os healthchecks do Compose.
HEALTHCHECK_INTERVAL=
HEALTHCHECK_TIMEOUT=
HEALTHCHECK_RETRIES=
HEALTHCHECK_START_PERIOD=
# Fase 2: obrigatórios para autenticação; sem valores padrão.
JWT_SECRET=
JWT_ALGORITHM=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=
# Somente para o comando manual de seed; não enviados ao serviço backend.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Reservados para fases posteriores.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
DEVICE_API_KEY=
