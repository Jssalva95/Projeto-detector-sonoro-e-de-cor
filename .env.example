# Obrigatórios: escolha valores locais antes de executar o Compose.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# URI PostgreSQL; no Compose, host postgres e porta interna padrão 5432.
# Use os mesmos dados acima; caracteres especiais da URI precisam de percent-encoding.
DATABASE_URL=
BACKEND_PORT=
FRONTEND_PORT=
# Endereço de interface local para publicação dos serviços.
BIND_ADDRESS=
# Parâmetros operacionais explícitos para os healthchecks do Compose.
HEALTHCHECK_INTERVAL=
HEALTHCHECK_TIMEOUT=
HEALTHCHECK_RETRIES=
HEALTHCHECK_START_PERIOD=
# Fase 2: obrigatórios para autenticação; sem valores padrão.
JWT_SECRET=
JWT_ALGORITHM=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=
# Somente para o comando manual de seed; não enviados ao serviço backend.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Fase 6.1: canais inativos até habilitação explícita; sem envio automático.
TELEGRAM_ENABLED=false
# Fase 6.2: obrigatório se algum canal estiver habilitado; segundos >= 0, sem default.
ALERT_COOLDOWN_SECONDS=
# Consulta /settings; intervalo independente para testes de envio da etapa 5.
# Valor local aprovado: 300 segundos. Sem default no codigo.
ALERT_TEST_COOLDOWN_SECONDS=
# Fase 6.3: intervalo de consulta da fila vazia; positivo, sem default.
ALERT_POLL_INTERVAL_SECONDS=
TELEGRAM_TIMEOUT_SECONDS=
TELEGRAM_BOT_TOKEN=
# Reservado; não é fallback de destino. O provider recebe destination explicitamente.
TELEGRAM_CHAT_ID=
EMAIL_ENABLED=false
SMTP_TIMEOUT_SECONDS=
# starttls ou ssl; sem fallback para conexão em texto claro.
SMTP_TLS_MODE=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Fase 3: chave compartilhada obrigatória para X-API-Key no heartbeat.
DEVICE_API_KEY=
# Fase 7.1: obrigatórios, sem defaults. Origens como array JSON de URLs http/https.
WS_AUTH_TIMEOUT_SECONDS=
WS_SEND_TIMEOUT_SECONDS=
WS_MAX_MESSAGE_BYTES=
WS_CLIENT_QUEUE_SIZE=
WS_ALLOWED_ORIGINS=
# Fase 8.1: origens HTTP exatas em array JSON, independentes do WebSocket.
CORS_ALLOWED_ORIGINS=
# URLs publicas acessiveis pelo navegador. Nunca incluir segredos em VITE_*.
# API: origem http/https, sem /api/v1. WS: URL completa de /api/v1/ws/events.
VITE_API_BASE_URL=
VITE_WS_URL=
